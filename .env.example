# Если используете свой локальный Postgres (без Docker):
# на Mac обычно нет пароля, имя пользователя = ваш логин macOS
DATABASE_URL=postgresql://YOUR_MACOS_USERNAME@localhost:5432/soil_ml

# Если используете вариант с Docker (docker-compose.yml) - раскомментируйте:
# DATABASE_URL=postgresql://soil_ml:soil_ml_dev_password@localhost:5432/soil_ml

# Защита демо-стенда (HTTP Basic Auth). Без DEMO_PASSWORD стенд не стартует.
DEMO_USER=demo
DEMO_PASSWORD=ЗАМЕНИТЕ_НА_СВОЙ
# DEMO_HOST=127.0.0.1   # 0.0.0.0 - доступ из локальной сети (только за HTTPS/VPN)

# Страница "Климат" (слои WorldClim из GeoServer, доступ через прокси приложения)
GEOSERVER_URL=http://127.0.0.1:8080/geoserver
GEOSERVER_WORKSPACE=ML
# GEOSERVER_USER=
# GEOSERVER_PASSWORD=
# CLIMATE_BASEMAP=none   # без внешней подложки OSM (изолированная сеть)
